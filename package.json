{
  "name": "sdp",
  "version": "0.1.0",
  "description": "Software delivery platform: living specifications, curated architecture and decisions as one queryable graph",
  "private": true,
  "type": "module",
  "bin": {
    "sdp": "./bin/sdp.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect.ts",
    "./steps": "./src/steps.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sdp": "node src/cli/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples/shop",
    "test": "node src/cli/main.ts run --concurrency 8",
    "check": "node src/cli/main.ts check",
    "verify": "npm run typecheck && node src/cli/main.ts check && node src/cli/main.ts run --concurrency 8 && node src/cli/main.ts gate GUIDE"
  },
  "dependencies": {
    "@cucumber/cucumber-expressions": "^20.2.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@cucumber/tag-expressions": "^11.0.1",
    "@effect/platform-node": "^4.1.4",
    "effect": "^4.1.4",
    "oxc-parser": "^0.158.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
